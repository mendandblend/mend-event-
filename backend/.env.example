PORT=5000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5174

# Firebase project ID.
FIREBASE_PROJECT_ID=mend-and-blend
# Optional: for hosts without Google Application Default Credentials, provide
# the service-account JSON as a private environment variable. Use either the
# raw JSON or its base64-encoded contents, never both. Do not commit either value.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# one_total or one_per_session
BOOKING_TICKET_LIMIT_POLICY=one_per_session
# Whole minutes, from 1 to 30
BOOKING_HOLD_MINUTES=10

# Use "test" during checkout testing. Set to "live" only with matching live keys.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Whole minutes, from 10 to 60
PAYMENT_HOLD_MINUTES=20
