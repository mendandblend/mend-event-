# Leave empty in local development: the Vite dev server proxies /api to http://localhost:5000.
# In production, set this to your deployed backend URL (e.g. https://soft-powderblue-gaur-34.hostingersite.com).
# WARNING: anything starting with VITE_ is visible to every visitor. Never put secrets here.
VITE_API_URL=

# Public Firebase web-app configuration (not Firebase Admin credentials).
# DO NOT put the Firebase service-account JSON in the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

